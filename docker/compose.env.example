# Settings for docker-compose.yml (host side). Copy to .env in the repo root:
#   cp docker/compose.env.example .env
# The bot's own settings stay in env.local, as on the host.

# Host folder of the Flutter repo, mounted at /repo. Use a separate clone for the bot:
# the bot runs `git checkout`, `flutter clean` and rewrites android/local.properties there.
# Create the folder yourself. If it is empty and REPO_CLONE_URL is set, it is cloned on start.
BOT_REPO_DIR=../flutter-repo-for-bot
REPO_CLONE_URL=

# Folder with the SSH key(s), config and known_hosts git needs. Default: ~/.ssh
BOT_SSH_DIR=

# Gitignored files to copy over the repo at every start, in the same layout as the repo:
#   docker/overlay/android/key.properties
#   docker/overlay/android/app/upload-keystore.jks
#   docker/overlay/android/local.properties          (e.g. googleMapsApiKey=...)
# Without key.properties the APK is signed with debug keys.
BOT_REPO_OVERLAY_DIR=./docker/overlay

# env.local to use. Default: ./env.local
BOT_ENV_LOCAL=

# Linux hosts: your `id -u` / `id -g`, so files written into BOT_REPO_DIR stay yours.
BOT_UID=1000
BOT_GID=1000

# Same version as `flutter --version` on your machine.
FLUTTER_VERSION=3.41.1
