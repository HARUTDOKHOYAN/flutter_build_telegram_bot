# BuildChatBot configuration — copy to env.local and fill in.
# Lines starting with # are comments. Blank values fall back to appsettings.json defaults.

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# API ID + Hash from https://my.telegram.org (required by WTelegramBot for >50 MB uploads)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Files at or above this size (MB) are sent via WTelegramBot instead of the Bot API.
TELEGRAM_LARGE_FILE_THRESHOLD_MB=49

# --- Repository (existing local Flutter project) ---
REPO_PATH=
REPO_BRANCH=master
REPO_REMOTE_NAME=origin
# SSH for private repos. Git operations shell out to the `git` binary, so ~/.ssh/config
# is honoured. Leave REPO_SSH_KEY_PATH empty when a `Host` entry there already sets
# IdentityFile (setting it here overrides that with -i and can pick the wrong key).
REPO_SSH_KEY_PATH=
# Passphrase of that key, if it has one. The bot has no terminal, so without this (or a
# key loaded into ssh-agent) a passphrase-protected key makes every pull fail.
REPO_SSH_PASSPHRASE=

# --- Flutter / build flags ---
FLUTTER_BIN=flutter
FLUTTER_TARGET_PLATFORM=android-arm64
# Leave blank if your project has no flavors
FLUTTER_FLAVOR=
# Optional alternate entrypoint, e.g. lib/main_dev.dart
FLUTTER_TARGET_FILE=
# Extra args appended verbatim to `flutter build apk` (after the define file, so they win)
FLUTTER_EXTRA_ARGS=
# Passed as --dart-define-from-file (relative to REPO_PATH). The Airexys app will not start in
# release mode without the backend hosts in it; a missing file fails the build. Blank keeps the
# default release.env; `none` turns it off.
FLUTTER_DART_DEFINE_FILE=release.env
FLUTTER_RUN_PUB_GET=true
FLUTTER_RUN_CLEAN=true

# --- Android toolchain ---
JAVA_HOME=
ANDROID_SDK_ROOT=
# Blank → autodetect under ANDROID_SDK_ROOT/build-tools/<latest>
APKSIGNER_PATH=

# Extra folders put in front of PATH for every build (release.sh, flutter, gradlew),
# ':'-separated, '~/' allowed. Use it when the bot (launchd) cannot find a tool your shell
# can, e.g. `dirname "$(which pod)"` or an fvm Flutter. Homebrew, ~/development/flutter/bin,
# rbenv shims and gem bin folders are already added automatically when they exist.
EXTRA_PATH=

# --- Artifact paths (relative to REPO_PATH for APK, working dir for caches) ---
APK_OUTPUT_RELATIVE=build/app/outputs/flutter-apk/app-release.apk
APK_CACHE_DIR=./cache/apks
TEMP_DIR_BASE=./tmp

# --- Runtime behavior ---
HEARTBEAT_SECONDS=30
QUEUE_CAPACITY=10
GRADLE_CLEAN_EVERY_N_BUILDS=20
LOG_DIR=./logs
BUILD_RECORD_PATH=./logs/builds.jsonl

# --- Release pipeline (/release_ios_testflight, /release_ios_appstore) ---
# The release build itself is owned by the Flutter repo's script, not by the bot.
# Path of that script, relative to REPO_PATH (an absolute path also works).
RELEASE_SCRIPT_PATH=tool/release.sh
# How long the bot waits for an answer to a version / build-number / confirm prompt
# before it cancels the pending release question.
RELEASE_PROMPT_TIMEOUT_SECONDS=300
# After a successful release build, commit + push the pubspec.yaml version bump
# (the committed pubspec is the release log). Set to false to leave it uncommitted.
RELEASE_COMMIT_VERSION_BUMP=true
# Author used for that commit.
RELEASE_GIT_AUTHOR_NAME=BuildChatBot
RELEASE_GIT_AUTHOR_EMAIL=buildbot@local

# --- Apple / App Store Connect (optional — required only for /release_ios_* ) ---
# How to create the API key:
#   App Store Connect → Users and Access → Integrations → App Store Connect API
#   → Team Keys → Generate. Give it the "App Manager" role.
#   The .p8 private key can be downloaded ONLY ONCE — store it somewhere safe
#   outside this repo (e.g. ~/.appstoreconnect/private_keys/) and keep the file
#   name Apple gives it: AuthKey_<KEYID>.p8.
#   The Key ID and the Issuer ID are both shown on that same page.
# 10-character Key ID of the App Store Connect API key.
APPLE_API_KEY_ID=
# Issuer ID of the team (a UUID, shown above the key list).
APPLE_API_ISSUER_ID=
# Absolute path to the downloaded AuthKey_<KEYID>.p8 file.
APPLE_API_KEY_PATH=
# Bundle identifier of the iOS app; used to resolve the App Store Connect app id.
APPLE_BUNDLE_ID=com.airexys.app
# How long to wait for App Store Connect to finish processing an uploaded build.
APPLE_PROCESSING_TIMEOUT_SECONDS=2400
# Seconds between processing polls.
APPLE_PROCESSING_POLL_SECONDS=30
# Mark processed builds as "does not use non-exempt encryption" so TestFlight does
# not stall on "Missing Compliance".
APPLE_SET_EXPORT_COMPLIANCE_EXEMPT=true
